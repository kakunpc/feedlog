# compose.dockge.example.yamlと一緒にスタック親フォルダへコピーし、
# ファイル名を.envにして設定してください。実際の秘密値は含めていません。
# 既存の.envは上書きしないでください。本番の.envを検証用に流用しないでください。

# 必須：新規DB用パスワード。新規作成ではランダムな16進文字列を推奨します。
# DATABASE_URLにも埋め込むため、URLの予約文字を含む場合は適切なエンコードが必要です。
# 既存DBを引き継ぐ場合、現在の値を維持してください。
POSTGRES_PASSWORD=

# 必須：32文字以上のランダム値。既存環境では現在の値を維持してください。
BETTER_AUTH_SECRET=

# 必須：末尾の/なし。既存環境では現在の公開URLを維持してください。
BETTER_AUTH_URL=http://localhost:3004

# 必須：管理者になるメールアドレス。初回のアカウント登録前に設定します。
SYSTEM_ADMIN_EMAILS=

# 既存のDockge構成と同じホスト側ポートです。
FEEDLOG_PORT=3004
FEEDLOG_BIND_ADDRESS=0.0.0.0

# 本番で使用中のDiscord設定は維持してください。
# callback: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 初期値はDiscordなどのOAuthだけでログインする構成です。
# Discord未設定でローカル確認する場合はtrueにして、通常のメール登録を使います。
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_VERIFY=false

# 任意：AI機能。ウィジェットのAIを使う場合、ツール呼び出し対応のモデル名も設定します。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=

# 任意：メール送信。検証時は空欄のままにし、本番の認証情報を流用しないでください。
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# 任意：S3互換ストレージ。未設定なら./data内にアップロードを保存します。
# 使用する場合はKEY・SECRET・BUCKETと、ENDPOINTまたはREGIONを設定します。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
